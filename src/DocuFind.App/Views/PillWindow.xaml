<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DocuFind.App.Views.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource PillBackdrop}"
          AllowDrop="True"
          DragEnter="OnDragEnter"
          DragOver="OnDragOver"
          DragLeave="OnDragLeave"
          Drop="OnDrop"
          PointerEntered="OnRootPointerEntered"
          PointerExited="OnRootPointerExited">

        <Border x:Name="Shell"
                CornerRadius="16"
                Background="{ThemeResource PillFill}"
                BorderBrush="{ThemeResource PillStrokeIdle}"
                BorderThickness="1">
            <Grid Padding="12,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="SearchGlyph"
                          Glyph="&#xE721;"
                          FontSize="16"
                          Margin="0,0,8,0"
                          Foreground="{ThemeResource StrongForeground}"
                          VerticalAlignment="Center" />

                <TextBox x:Name="QueryBox"
                         Grid.Column="1"
                         PlaceholderText="搜索文档内容"
                         FontSize="14"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="0"
                         Background="Transparent"
                         VerticalAlignment="Center"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         AutomationProperties.Name="在文档中搜索"
                         TextChanged="OnQueryTextChanged"
                         KeyDown="OnQueryKeyDown"
                         AllowDrop="True"
                         DragEnter="OnDragEnter"
                         DragOver="OnDragOver"
                         DragLeave="OnDragLeave"
                         Drop="OnDrop">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource PillPlaceholderColor}" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{ThemeResource PillPlaceholderColor}" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource PillPlaceholderColor}" />
                    </TextBox.Resources>
                </TextBox>

                <!--
                    右侧只有一个位置：空闲时是“文档库”按钮，
                    一打字就换成忙碌圈，同时让输入框伸到最右边——
                    这样自带的清除按钮（×）才会贴在胶囊右端，而不是停在中间。
                -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ProgressRing x:Name="BusyRing"
                                  Width="11"
                                  Height="11"
                                  Visibility="Collapsed"
                                  IsActive="False"
                                  Foreground="{ThemeResource HighlightForeground}"
                                  VerticalAlignment="Center" />

                    <Border x:Name="BrandChip"
                            Width="24"
                            Height="24"
                            CornerRadius="6"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="文档库"
                            ToolTipService.ToolTip="文档库"
                            PointerEntered="OnBrandPointerEntered"
                            PointerExited="OnBrandPointerExited">
                        <FontIcon x:Name="BrandGlyph"
                                  Glyph="&#xE8A5;"
                                  FontSize="13"
                                  Foreground="{ThemeResource SnippetForeground}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 拖放高亮 -->
        <Border x:Name="DropOverlay"
                Visibility="Collapsed"
                CornerRadius="16"
                Background="{ThemeResource DropFill}"
                BorderBrush="{ThemeResource DropStroke}"
                BorderThickness="1.5"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource DropStroke}" />
                <TextBlock Text="松开加入" FontSize="11" Foreground="{ThemeResource DropText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
