<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DocuFind.App</RootNamespace>
    <AssemblyName>DocuFind</AssemblyName>
    <ApplicationIcon>..\..\assets\icon\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocuFind.Core\DocuFind.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\models\bge-small-zh-v1.5-int8.onnx')">
    <Content Include="..\..\models\bge-small-zh-v1.5-int8.onnx" Link="models\bge-small-zh-v1.5-int8.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\vocab.txt" Link="models\vocab.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    dotnet publish 不会把应用自己的 .pri（XAML 资源索引）带进输出目录，
    缺了它启动时 InitializeComponent 会抛 XamlParseException。
    这里在 publish 之后补一次拷贝，保证发布目录可以独立运行。
  -->
  <Target Name="CopyPriToPublish" AfterTargets="Publish" Condition="Exists('$(TargetDir)$(TargetName).pri')">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
